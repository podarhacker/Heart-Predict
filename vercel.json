{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
    "routes": [
    { "src": "/api/predict", "dest": "/api/predict.py" },
    { "src": "/api/train", "dest": "/api/train.py" },
    { "src": "/api/model-status", "dest": "/api/model-status.py" },
    { "src": "/api/track", "dest": "/api/track.py" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
  
}
